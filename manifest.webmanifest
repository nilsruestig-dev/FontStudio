{
  "name": "FontStudio",
  "short_name": "FontStudio",
  "description": "Text in deiner Handschrift auf dein Arbeitsblatt legen.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#eceff5",
  "theme_color": "#2340c8",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        { "name": "file", "accept": ["application/pdf", ".pdf", "image/*", ".png", ".jpg", ".jpeg", ".webp"] }
      ]
    }
  }
}
